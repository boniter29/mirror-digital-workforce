{
  "name": "mirror-digital-twin",
  "version": "0.8.0",
  "private": true,
  "author": "镜我产品团队",
  "description": "Local-first personal digital twin powered exclusively by the Claude Agent SDK.",
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 dist-electron/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run --config vitest.config.ts",
    "staging:live": "npm run build && cross-env MIRROR_LIVE_STAGING=all electron .",
    "preview": "vite preview --host 127.0.0.1",
    "package": "npm run package:win",
    "prepare:dws": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-bundled-dws.ps1",
    "prepare:ocr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-ocr-sidecar.ps1",
    "test:ocr:live": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-ocr-sidecar.ps1",
    "package:dir": "npm run prepare:dws && npm run prepare:ocr && npm run build && electron-builder --win --dir",
    "package:win": "npm run prepare:dws && npm run prepare:ocr && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@paddleocr/api-sdk": "^0.2.3",
    "date-fns": "^4.1.0",
    "dingtalk-stream": "^2.1.6-beta.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "read-excel-file": "^6.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.mirror.digitaltwin",
    "productName": "镜我",
    "artifactName": "Mirror-${version}-Windows-${arch}-Setup.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk*/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-*/**/*"
    ],
    "extraResources": [
      {
        "from": "build-resources/dws",
        "to": "tools/dws",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-resources/ocr",
        "to": "tools/ocr",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png",
      "executableName": "Mirror",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "镜我",
      "uninstallDisplayName": "镜我 ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN"
      ]
    }
  }
}
